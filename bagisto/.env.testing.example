APP_NAME=Bagisto
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_ADMIN_URL=admin
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_CURRENCY=VND

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# Match this to FORWARD_DB_PORT in .env; Docker Compose defaults to 3306.
DB_PORT=3306
DB_DATABASE=bagisto_testing
DB_USERNAME=bagisto_test
DB_PASSWORD=bagisto_test
DB_PREFIX=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
RESPONSE_CACHE_ENABLED=false
