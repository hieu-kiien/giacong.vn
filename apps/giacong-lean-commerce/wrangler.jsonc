{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "giacong-vn",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "giacong-vn-staging",
      "routes": [
        {
          "pattern": "admin-staging.kienhieu.id.vn/*",
          "zone_name": "kienhieu.id.vn"
        }
      ],
      "vars": {
        "ADMIN_HOSTNAME": "admin-staging.kienhieu.id.vn",
        "TEAM_DOMAIN": "https://jolly-brook-7bc8.cloudflareaccess.com",
        "POLICY_AUD": "3a6f8119b3824e5b5b50ba6830f697f1ac8e998bb0246307310b74c91073f35f"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "GIACONG_VN_CATALOG",
          "database_name": "giacong-vn-catalog-staging",
          "database_id": "981b5d5e-bba9-4f7e-9e1e-a15e379cd095"
        }
      ],
      "r2_buckets": [
        {
          "binding": "GIACONG_VN_PRODUCT_MEDIA",
          "bucket_name": "giacong-vn-product-media-staging"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "giacong-vn-next-cache-staging"
        }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
}
