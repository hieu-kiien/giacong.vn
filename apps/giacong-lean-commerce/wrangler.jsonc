{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "giacong-vn",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": false,
  "routes": [
    {
      "pattern": "kienhieu.id.vn/*",
      "zone_name": "kienhieu.id.vn"
    },
    {
      "pattern": "admin.kienhieu.id.vn/*",
      "zone_name": "kienhieu.id.vn"
    }
  ],
  "vars": {
    "ADMIN_HOSTNAME": "admin.kienhieu.id.vn",
    "ADMIN_HOSTNAMES": "admin.kienhieu.id.vn",
    "ADMIN_PUBLIC": "false",
    "TEAM_DOMAIN": "https://jolly-brook-7bc8.cloudflareaccess.com",
    "POLICY_AUD": "3a6f8119b3824e5b5b50ba6830f697f1ac8e998bb0246307310b74c91073f35f"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "GIACONG_VN_CATALOG",
      "database_name": "giacong-vn-catalog",
      "database_id": "f6aabba5-e19b-4c7f-ad87-3b40e84b9bf6",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GIACONG_VN_PRODUCT_MEDIA",
      "bucket_name": "giacong-vn-product-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "giacong-vn-next-cache"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "GIACONG_VN_LEAD_QUEUE",
        "queue": "giacong-vn-leads"
      }
    ],
    "consumers": [
      {
        "queue": "giacong-vn-leads",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "giacong-vn-leads-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "giacong-vn-staging",
      "routes": [
        {
          "pattern": "staging.kienhieu.id.vn/*",
          "zone_name": "kienhieu.id.vn"
        },
        {
          "pattern": "admin-staging.kienhieu.id.vn/*",
          "zone_name": "kienhieu.id.vn"
        }
      ],
      "vars": {
        "ADMIN_HOSTNAME": "admin-staging.kienhieu.id.vn",
        "ADMIN_HOSTNAMES": "admin-staging.kienhieu.id.vn",
        "ADMIN_PUBLIC": "false",
        "STAGING_DIRECT_QA_MODE": "readonly-public-qa",
        "TEAM_DOMAIN": "https://jolly-brook-7bc8.cloudflareaccess.com",
        "POLICY_AUD": "3a6f8119b3824e5b5b50ba6830f697f1ac8e998bb0246307310b74c91073f35f"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "GIACONG_VN_CATALOG",
          "database_name": "giacong-vn-catalog-staging",
          "database_id": "981b5d5e-bba9-4f7e-9e1e-a15e379cd095",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "GIACONG_VN_PRODUCT_MEDIA",
          "bucket_name": "giacong-vn-product-media-staging"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "giacong-vn-next-cache-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "GIACONG_VN_LEAD_QUEUE",
            "queue": "giacong-vn-leads-staging"
          }
        ],
        "consumers": [
          {
            "queue": "giacong-vn-leads-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "giacong-vn-leads-staging-dlq"
          }
        ]
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
