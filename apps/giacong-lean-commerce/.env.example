# Cổng xem trước giao diện độc lập; không dùng các cổng 3000, 8000 hoặc 8001.
COMMERCE_PREVIEW_PORT=4310

# Catalog/media production dùng Cloudflare bindings khai báo trong wrangler.jsonc:
# GIACONG_VN_CATALOG (D1) và GIACONG_VN_PRODUCT_MEDIA (R2).
# Không đặt API key D1/R2 trong .env.

# Webhook Google Apps Script nhận yêu cầu liên hệ. Chỉ chấp nhận HTTPS trên script.google.com hoặc script.googleusercontent.com.
GOOGLE_SHEETS_WEBHOOK_URL=
# Khóa chia sẻ tùy chọn, chỉ gửi server-to-server trong JSON body.
GOOGLE_SHEETS_WEBHOOK_SECRET=
