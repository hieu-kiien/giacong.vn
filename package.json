{
  "name": "giacong-lean-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Lean V1 B2B storefront with Bagisto admin and Google Sheet request intake",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:contact": "node --no-warnings --experimental-strip-types --test scripts/contact-webhook.test.mts scripts/contact-context.test.mts scripts/development-port.test.mjs scripts/google-apps-script-template.test.mjs scripts/lean-frontend-boundary.test.mjs",
    "qa:catalog": "node scripts/verify-catalog-storefront.mjs",
    "qa:services": "node scripts/verify-service-ia.mjs",
    "check": "npm run test:contact && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
