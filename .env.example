# URL nội bộ hoặc public của Bagisto. Không thêm /api ở cuối URL.
BAGISTO_API_URL=http://127.0.0.1:18001
# Đích nội bộ để một hostname public phục vụ /admin, /api/b2b và asset Bagisto.
# Khi chạy Docker/production, đặt thành hostname service Bagisto trong private network.
BAGISTO_PROXY_ORIGIN=http://127.0.0.1:18001
# Thời gian chờ BFF gọi Bagisto (milliseconds, từ 100 đến 30000).
BAGISTO_API_TIMEOUT_MS=5000

# Cổng xem trước giao diện độc lập; không dùng các cổng 3000, 8000 hoặc 8001.
COMMERCE_PREVIEW_PORT=4310

# Webhook Google Apps Script nhận yêu cầu liên hệ. Chỉ chấp nhận HTTPS trên script.google.com hoặc script.googleusercontent.com.
GOOGLE_SHEETS_WEBHOOK_URL=
# Bắt buộc ở production: tối thiểu 32 ký tự, chỉ gửi server-to-server trong JSON body.
GOOGLE_SHEETS_WEBHOOK_SECRET=
